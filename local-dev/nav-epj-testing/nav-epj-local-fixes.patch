           valkeyService.saveLaunchContext(launchId, LaunchContext(patient.id, encounter.id))
 
           val iss = env.smart.fhirServerUrl
-          call.respondRedirect("$appUrl/?iss=$iss&launch=$launchId")
+          // Lokal fix (ikke committet upstream): iss/launch ble limt inn i URL-en uten
+          // url-encoding. iss inneholder "://" som blant annet Altinn Local Test sin nginx
+          // stripper fra query-strings hvis det ikke er prosentkodet (samme mekanisme brukes
+          // her via URLBuilder som allerede var korrekt for rejectViaRedirect).
+          val launchTarget =
+            URLBuilder("$appUrl/").apply {
+              parameters.append("iss", iss)
+              parameters.append("launch", launchId)
+            }
+          call.respondRedirect(launchTarget.buildString())
         }
       }
 
@@ -189,7 +198,17 @@ fun Application.configureSmartRouting() {
               codeChallenge = codeChallenge,
             ),
           )
-          call.respondRedirect("$redirectUri?code=$code&state=$state")
+          // Lokal fix (ikke committet upstream): code/state ble limt inn uten url-encoding.
+          // state er en base64-streng (kan inneholde +, /, =) — en ren "+" i en query-string
+          // blir tolket som mellomrom av standard application/x-www-form-urlencoded-parsing
+          // (bl.a. hos mottakende klient), noe som korrumperer state-verdien og trigger en
+          // falsk "State mismatch — possible CSRF"-avvisning hos klienten omtrent hver gang.
+          val callbackTarget =
+            URLBuilder(redirectUri).apply {
+              parameters.append("code", code)
+              parameters.append("state", state)
+            }
+          call.respondRedirect(callbackTarget.buildString())
         }
       }
     }
