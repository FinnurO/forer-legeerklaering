diff --git a/src/main/kotlin/no/nav/helse/fhir/EpjClient.kt b/src/main/kotlin/no/nav/helse/fhir/EpjClient.kt
index 2fa7d22..ddae658 100644
--- a/src/main/kotlin/no/nav/helse/fhir/EpjClient.kt
+++ b/src/main/kotlin/no/nav/helse/fhir/EpjClient.kt
@@ -6,12 +6,27 @@ import io.ktor.client.plugins.*
 import io.ktor.client.plugins.contentnegotiation.*
 import io.ktor.client.plugins.logging.*
 import io.ktor.serialization.jackson3.*
+import no.nav.helse.plugins.localDateTimeModule
+import no.nav.helse.plugins.uuidModule
 import tools.jackson.databind.SerializationFeature
+import tools.jackson.module.kotlin.KotlinModule
 
 fun initEpjClient(baseUrl: String): HttpClient {
   return HttpClient(CIO) {
     install(Logging)
-    install(ContentNegotiation) { jackson { enable(SerializationFeature.INDENT_OUTPUT) } }
+    install(ContentNegotiation) {
+      jackson {
+        enable(SerializationFeature.INDENT_OUTPUT)
+        // Lokal fix (ikke committet upstream): denne klienten manglet KotlinModule/uuidModule/
+        // localDateTimeModule som configureSerialization() registrerer for hovedserveren
+        // (plugins/Serialization.kt). Uten disse feiler PatientService/PractitionerService/
+        // EncounterService osv. sin deserialisering av *Id-verdiklassene og
+        // kotlinx.datetime.LocalDateTime-feltene.
+        addModule(KotlinModule.Builder().build())
+        addModule(uuidModule)
+        addModule(localDateTimeModule)
+      }
+    }
     defaultRequest { url(baseUrl) }
   }
 }
diff --git a/src/main/kotlin/no/nav/helse/plugins/Serialization.kt b/src/main/kotlin/no/nav/helse/plugins/Serialization.kt
index a8e0931..7b71263 100644
--- a/src/main/kotlin/no/nav/helse/plugins/Serialization.kt
+++ b/src/main/kotlin/no/nav/helse/plugins/Serialization.kt
@@ -4,6 +4,7 @@ import io.ktor.serialization.jackson3.*
 import io.ktor.server.application.*
 import io.ktor.server.plugins.contentnegotiation.*
 import kotlin.uuid.Uuid
+import kotlinx.datetime.LocalDateTime
 import tools.jackson.core.JsonGenerator
 import tools.jackson.core.JsonParser
 import tools.jackson.databind.DeserializationContext
@@ -28,7 +29,38 @@ val uuidModule: SimpleModule =
       Uuid::class.java,
       object : ValueDeserializer<Uuid>() {
         override fun deserialize(p: JsonParser, ctxt: DeserializationContext): Uuid =
-          Uuid.parse(p.toString())
+          // Lokal fix (ikke committet upstream): p.toString() returnerte parserens Java
+          // toString() (f.eks. "tools.jackson.core.json.UTF8StreamJsonParser@...", 53 tegn),
+          // ikke den faktiske JSON-strengverdien -> Uuid.parse feilet alltid når denne
+          // deserializeren faktisk ble brukt (jf. p.getString() i JsonParser sitt API).
+          Uuid.parse(p.string)
+      },
+    )
+  }
+
+// Lokal fix (ikke committet upstream): kotlinx.datetime.LocalDateTime hadde ingen registrert
+// (de)serializer noe sted. Serialisering "virket" bare tilfeldig via generisk bean-refleksjon
+// (produserte et internt, ikke-standard JSON-objekt med bl.a. et syntetisk
+// "value$kotlinx_datetime"-felt), men deserialisering feilet alltid med
+// KotlinInvalidNullException siden Kotlin-modulens creator-baserte deserializer forventer noe
+// helt annet enn den formen. Konkret reprodusert av EncounterService (via epjClient) sitt kall
+// mot /api/patients/{id}/konsultasjoner/active, som deserialiserer en Konsultasjon inkludert
+// startetTidspunkt/avsluttetTidspunkt.
+val localDateTimeModule: SimpleModule =
+  SimpleModule().apply {
+    addSerializer(
+      LocalDateTime::class.java,
+      object : ValueSerializer<LocalDateTime>() {
+        override fun serialize(value: LocalDateTime, gen: JsonGenerator, ctxt: SerializationContext) {
+          gen.writeString(value.toString())
+        }
+      },
+    )
+    addDeserializer(
+      LocalDateTime::class.java,
+      object : ValueDeserializer<LocalDateTime>() {
+        override fun deserialize(p: JsonParser, ctxt: DeserializationContext): LocalDateTime =
+          LocalDateTime.parse(p.string)
       },
     )
   }
@@ -39,6 +71,7 @@ fun Application.configureSerialization() {
       enable(SerializationFeature.INDENT_OUTPUT)
       addModule(KotlinModule.Builder().build())
       addModule(uuidModule)
+      addModule(localDateTimeModule)
     }
   }
 }
